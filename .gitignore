/assets/store/screenshots/pending-share.png
/assets/store/screenshots/popup-clean.png
/assets/store/screenshots/popup-with-keyboard-current.png

# Android local Kotlin cache
/android/.kotlin/

# Android signing files
/android/key.properties
/android/*.jks
/android/*.keystore

# Local publishing credentials (never commit)
/android/app/secret/
