**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local device testing artifacts
/after_*.png
/app_launch.png
/chapters_sheet.png
/current_*.png
/current_*.xml
/device_screen*.png
/window_dump*.xml
/assets/store/screenshots/*.xml
